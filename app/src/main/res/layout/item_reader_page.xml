<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/page_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Left Page Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/left_page_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="2dp"
            app:cardMaxElevation="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Text Content -->
                <TextView
                    android:id="@+id/left_page_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/left_page_number"
                    android:layout_alignParentTop="true"
                    android:padding="24dp"
                    android:scrollbars="none"
                    android:text="Page Text Left"
                    android:textColor="@color/sepia_text"
                    android:textSize="18sp" />

                <!-- Page Number -->
                <TextView
                    android:id="@+id/left_page_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="16dp"
                    android:text="1"
                    android:textColor="@color/sepia_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="italic" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Spine Crease Shadow Divider -->
        <View
            android:id="@+id/spine_crease"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/spine_shadow_gradient"
            android:visibility="gone" />

        <!-- Right Page Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/right_page_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="2dp"
            app:cardMaxElevation="4dp"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Text Content -->
                <TextView
                    android:id="@+id/right_page_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/right_page_number"
                    android:layout_alignParentTop="true"
                    android:padding="24dp"
                    android:scrollbars="none"
                    android:text="Page Text Right"
                    android:textColor="@color/sepia_text"
                    android:textSize="18sp" />

                <!-- Page Number -->
                <TextView
                    android:id="@+id/right_page_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_parentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="16dp"
                    android:text="2"
                    android:textColor="@color/sepia_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="italic" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Translucent Overlay used by Page Transformer to render 3D turning shadow depth -->
    <View
        android:id="@+id/page_shadow_overlay"
        android:tag="shadow_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
