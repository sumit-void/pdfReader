<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reader_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sepia_window_bg">

    <!-- Main Reader Screen Area -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 3D Page ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/reader_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Controls Overlay Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/reader_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/sepia_page_bg"
            android:translationY="0dp"
            app:elevation="4dp"
            android:visibility="visible">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/reader_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@android:drawable/ic_menu_revert"
                app:navigationContentDescription="Back"
                app:title="Book Title"
                app:titleTextColor="@color/sepia_text"
                app:titleTextAppearance="@style/ReaderToolbarTitle">

                <!-- Action controls on the right of toolbar -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal"
                    android:layout_gravity="end"
                    android:paddingEnd="12dp">

                    <!-- Table of contents drawer toggle -->
                    <ImageView
                        android:id="@+id/btn_drawer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/sepia_text" />

                    <!-- Search Button -->
                    <ImageView
                        android:id="@+id/btn_search"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_search"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/sepia_text" />

                    <!-- Bookmark Toggle Button -->
                    <ImageView
                        android:id="@+id/btn_bookmark"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@android:drawable/btn_star_big_off"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/sepia_text" />

                    <!-- Settings Button -->
                    <ImageView
                        android:id="@+id/btn_settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_preferences"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/sepia_text" />

                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Bottom Controls Overlay Bar -->
        <LinearLayout
            android:id="@+id/reader_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/sepia_page_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="6dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Page progress display -->
                <TextView
                    android:id="@+id/txt_page_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Page 1 of 100"
                    android:textColor="@color/sepia_text_secondary"
                    android:fontFamily="serif"
                    android:textSize="12sp" />

                <!-- Reading Timer Button -->
                <TextView
                    android:id="@+id/btn_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Timer: Off"
                    android:textColor="@color/accent_gold"
                    android:fontFamily="serif"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/reader_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/accent_gold"
                android:thumbTint="@color/accent_gold" />
        </LinearLayout>

        <!-- Dynamic Overlay for Search Keyword Results -->
        <androidx.cardview.widget.CardView
            android:id="@+id/search_panel"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/sepia_page_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/search_close"
                        android:hint="Search keyword..."
                        android:fontFamily="serif"
                        android:textColor="@color/sepia_text"
                        android:textColorHint="@color/sepia_text_secondary"
                        android:backgroundTint="@color/accent_gold"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1" />

                    <ImageView
                        android:id="@+id/search_close"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/sepia_text_secondary"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </RelativeLayout>

                <!-- Search progress indicator -->
                <ProgressBar
                    android:id="@+id/search_progress"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent_gold"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Search Results recycler -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_results_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer Content (TOC / Outline chapters and saved bookmarks) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/reader_navigation_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/sepia_page_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Drawer header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="Navigation Shelf"
                android:textColor="@color/sepia_text"
                android:fontFamily="serif"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@color/sepia_divider" />

            <!-- Tabs control -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/drawer_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/sepia_page_bg"
                app:tabSelectedTextColor="@color/accent_gold"
                app:tabTextColor="@color/sepia_text_secondary"
                app:tabIndicatorColor="@color/accent_gold">
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contents" />
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bookmarks" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Container for switching lists -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Table of Contents Recycler -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/drawer_toc_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />

                <!-- Bookmarks Recycler -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/drawer_bookmarks_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
