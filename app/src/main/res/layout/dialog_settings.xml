<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadiusTopStart="16dp"
    app:cardCornerRadiusTopEnd="16dp"
    app:cardBackgroundColor="@color/sepia_page_bg"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Drag Indicator Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/sepia_divider"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading Preferences"
            android:textColor="@color/sepia_text"
            android:fontFamily="serif"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Theme block -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THEME"
            android:textColor="@color/sepia_text_secondary"
            android:fontFamily="serif"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Sepia Theme btn -->
            <Button
                android:id="@+id/btn_theme_sepia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Sepia"
                android:textSize="12sp"
                android:textColor="@color/sepia_text"
                android:fontFamily="serif"
                app:backgroundTint="@color/sepia_window_bg"
                app:strokeColor="@color/accent_gold"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Light Theme btn -->
            <Button
                android:id="@+id/btn_theme_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="Light"
                android:textSize="12sp"
                android:textColor="@color/light_text"
                android:fontFamily="serif"
                app:backgroundTint="@color/light_page_bg"
                app:strokeColor="@color/light_divider"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Dark Theme btn -->
            <Button
                android:id="@+id/btn_theme_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Charcoal"
                android:textSize="12sp"
                android:textColor="@color/dark_text"
                android:fontFamily="serif"
                app:backgroundTint="@color/dark_page_bg"
                app:strokeColor="@color/dark_divider"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Typography font family block -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TYPOGRAPHY"
            android:textColor="@color/sepia_text_secondary"
            android:fontFamily="serif"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Lora (Serif) -->
            <Button
                android:id="@+id/btn_font_lora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Lora"
                android:textSize="12sp"
                android:textColor="@color/sepia_text"
                android:fontFamily="serif"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <!-- Playfair -->
            <Button
                android:id="@+id/btn_font_playfair"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="Playfair"
                android:textSize="12sp"
                android:textColor="@color/sepia_text"
                android:fontFamily="serif"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <!-- Sans-serif -->
            <Button
                android:id="@+id/btn_font_sans"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Sans"
                android:textSize="12sp"
                android:textColor="@color/sepia_text"
                android:fontFamily="sans-serif"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>

        <!-- Font Size & Margin Spacing block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Font size segment -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FONT SIZE"
                    android:textColor="@color/sepia_text_secondary"
                    android:fontFamily="serif"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_size_decrease"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="-"
                        android:textSize="16sp"
                        android:textColor="@color/sepia_text"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <TextView
                        android:id="@+id/txt_font_size"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="18"
                        android:textColor="@color/sepia_text"
                        android:fontFamily="serif"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_size_increase"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="+"
                        android:textSize="16sp"
                        android:textColor="@color/sepia_text"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- Spacing margin segment -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAGE MARGINS"
                    android:textColor="@color/sepia_text_secondary"
                    android:fontFamily="serif"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Narrow margin -->
                    <ImageButton
                        android:id="@+id/btn_margin_narrow"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:src="@android:drawable/ic_menu_sort_alphabetically"
                        android:background="?attr/selectableItemBackground"
                        app:tint="@color/sepia_text_secondary"
                        android:contentDescription="Narrow margin" />

                    <!-- Standard margin -->
                    <ImageButton
                        android:id="@+id/btn_margin_standard"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        android:background="?attr/selectableItemBackground"
                        app:tint="@color/sepia_text"
                        android:contentDescription="Standard margin" />

                    <!-- Wide margin -->
                    <ImageButton
                        android:id="@+id/btn_margin_wide"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:background="?attr/selectableItemBackground"
                        app:tint="@color/sepia_text_secondary"
                        android:contentDescription="Wide margin" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Brightness segment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCREEN BRIGHTNESS"
            android:textColor="@color/sepia_text_secondary"
            android:fontFamily="serif"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/sepia_text_secondary"
                android:alpha="0.6" />

            <SeekBar
                android:id="@+id/brightness_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:progressTint="@color/accent_gold"
                android:thumbTint="@color/accent_gold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/sepia_text" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
