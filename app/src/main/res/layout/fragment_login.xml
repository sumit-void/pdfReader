<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sepia_window_bg"
    android:padding="24dp">

    <!-- Top decorative paper crease shadow -->
    <View
        android:id="@+id/crease_shadow"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:background="@drawable/spine_shadow_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/sepia_page_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal">

            <!-- Logo / Emblem -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_book"
                app:tint="@color/accent_gold"
                android:alpha="0.85" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paperback"
                android:textColor="@color/sepia_text"
                android:fontFamily="serif"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your books. Re-imagined."
                android:textColor="@color/sepia_text_secondary"
                android:fontFamily="serif"
                android:textSize="14sp"
                android:textStyle="italic"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp" />

            <!-- Username Dummy Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="@color/accent_gold"
                app:hintTextColor="@color/sepia_text_secondary"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email or Username"
                    android:textColor="@color/sepia_text"
                    android:fontFamily="serif"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Dummy Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:boxStrokeColor="@color/accent_gold"
                app:hintTextColor="@color/sepia_text_secondary"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/sepia_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    android:textColor="@color/sepia_text"
                    android:fontFamily="serif"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Enter Library"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/accent_gold" />

            <!-- Skip Button -->
            <TextView
                android:id="@+id/login_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Access (Guest)"
                android:textColor="@color/accent_gold"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:padding="8dp"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
