<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/sepia_page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <!-- Page Preview Image -->
        <ImageView
            android:id="@+id/bookmark_preview"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="#D2C8B5"
            android:scaleType="centerCrop"
            android:layout_marginEnd="12dp"
            android:contentDescription="Page preview" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/bookmark_page_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Page 1"
                android:textColor="@color/sepia_text"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bookmark_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="May 21, 2026 12:00 PM"
                android:textColor="@color/sepia_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Delete Button (X or Trash) -->
        <ImageView
            android:id="@+id/bookmark_delete_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete bookmark"
            app:tint="@color/sepia_text_secondary" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
